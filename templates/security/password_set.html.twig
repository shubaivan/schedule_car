<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="referrer" content="no-referrer">
<title>Новий пароль · {{ company }}</title>
{#
    Форма нового пароля за посиланням із бота (PasswordController::set). GET лише
    показує форму — посилання гасне тільки після збереження пароля.
#}
{{ include('security/_login_style.html.twig') }}
</head>
<body>
<main class="card">
  <div class="brand">
    <div class="logo">🔑</div>
    <h1>{% if first %}Пароль для входу{% else %}Новий пароль{% endif %}</h1>
    <div class="sub">{{ company }}</div>
  </div>

  {% if not valid %}
    <div class="note error">Посилання застаріло або вже використане.</div>
    <p class="tg-hint">Попросіть нове: у боті Плану надішліть <b>/parol</b> або натисніть «Забули пароль?» на сторінці входу.</p>
    <a class="btn ghost" href="{{ path('app_login') }}">← До входу</a>
  {% else %}
    {% if error %}<div class="note error">{{ error }}</div>{% endif %}
    <p class="tg-hint">{{ name }}{% if phone %}, ваш логін — номер <b>{{ phone }}</b>{% endif %}.</p>
    <form class="pw" method="post">
      <input type="text" name="username" value="{{ phone }}" autocomplete="username" hidden>
      <label>Новий пароль
        <input name="password" type="password" autocomplete="new-password" minlength="{{ min }}" maxlength="128" required autofocus>
      </label>
      <label>Ще раз
        <input name="repeat" type="password" autocomplete="new-password" minlength="{{ min }}" maxlength="128" required>
      </label>
      <ul class="rules">
        <li>щонайменше {{ min }} символів, і літери, і цифри;</li>
        <li>без вашого номера телефону;</li>
        <li>не той, що ви використовуєте деінде.</li>
      </ul>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('pw_set') }}">
      <button class="btn primary" type="submit">Зберегти пароль</button>
      <p class="tg-hint">Після збереження увійдіть заново — інші відкриті входи в План завершаться.</p>
    </form>
  {% endif %}

  <div class="foot">Пароль знаєте лише ви — нікому його не передавайте.<br>Увійти через Telegram можна й далі.</div>
</main>
</body>
</html>
