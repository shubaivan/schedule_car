<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Sans+Condensed:wght@500;600;700&family=Golos+Text:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">

<style>
  :root {
    --bg: #EBEBE5;
    --surface: #FFFFFF;
    --surface-2: #F5F5F0;
    --ink: #1A1C19;
    --muted: #5D615A;
    --rule: #C9CAC1;
    --rule-soft: #DEDFD7;
    --mark: #E4B106;
    --mark-ink: #1A1C19;
    --alert: #9E3521;

    --display: "Fira Sans Condensed", "Arial Narrow", Arial, sans-serif;
    --body: "Golos Text", "Segoe UI", Roboto, Arial, sans-serif;
    --mono: "JetBrains Mono", "SF Mono", Consolas, monospace;

    --shell: 1180px;
    --col: 64ch;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #131511;
      --surface: #1C1F1A;
      --surface-2: #232720;
      --ink: #E8E9E1;
      --muted: #9BA093;
      --rule: #363A31;
      --rule-soft: #2A2E26;
      --mark: #E4B106;
      --mark-ink: #131511;
      --alert: #E08061;
    }
  }

  :root[data-theme="dark"] {
    --bg: #131511;
    --surface: #1C1F1A;
    --surface-2: #232720;
    --ink: #E8E9E1;
    --muted: #9BA093;
    --rule: #363A31;
    --rule-soft: #2A2E26;
    --mark: #E4B106;
    --mark-ink: #131511;
    --alert: #E08061;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--body);
    font-size: 17px;
    line-height: 1.62;
    -webkit-text-size-adjust: 100%;
  }

  .shell {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 0 20px 96px;
  }

  /* ---------- Шапка ---------- */

  .masthead {
    border-bottom: 2px solid var(--ink);
    padding: 40px 0 18px;
    margin-bottom: 8px;
  }

  .eyebrow {
    font-family: var(--display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }

  h1 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(44px, 9vw, 82px);
    line-height: 0.94;
    letter-spacing: -0.015em;
    text-wrap: balance;
    margin: 0 0 18px;
  }

  h1 .mark {
    background: var(--mark);
    color: var(--mark-ink);
    padding: 0 0.12em;
  }

  .lede {
    max-width: 54ch;
    font-size: 19px;
    color: var(--ink);
    margin: 0 0 24px;
  }

  .stamps {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    padding-bottom: 4px;
  }

  .stamp {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .stamp b {
    color: var(--ink);
    font-weight: 500;
  }

  /* ---------- Разделы техкарты ---------- */

  .block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px 40px;
    padding: 34px 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  @media (min-width: 900px) {
    .block {
      grid-template-columns: 168px minmax(0, 1fr);
    }
  }

  .field {
    font-family: var(--display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 10px;
  }

  .field .num {
    display: block;
    font-size: 34px;
    line-height: 1;
    letter-spacing: 0;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .body { max-width: var(--col); }

  h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(28px, 4.6vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-wrap: balance;
    margin: 0 0 14px;
  }

  h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.2;
    margin: 28px 0 8px;
  }

  p { margin: 0 0 14px; }
  p:last-child { margin-bottom: 0; }

  .muted { color: var(--muted); }

  code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--surface-2);
    border: 1px solid var(--rule-soft);
    border-radius: 4px;
    padding: 1px 5px;
    white-space: nowrap;
  }

  ul, ol {
    margin: 0 0 14px;
    padding-left: 22px;
  }

  li { margin-bottom: 7px; }
  li:last-child { margin-bottom: 0; }

  b, strong { font-weight: 600; }

  /* ---------- Макет экрана бота ---------- */

  .screen {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 12px;
    padding: 14px 15px;
    margin: 18px 0;
    max-width: 420px;
    box-shadow: 0 1px 0 var(--rule-soft);
  }

  .screen-text {
    font-size: 15px;
    line-height: 1.5;
    margin: 0 0 12px;
  }

  .screen-text b { font-weight: 600; }

  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .key {
    flex: 1 1 auto;
    min-width: 120px;
    text-align: center;
    font-size: 14px;
    padding: 9px 10px;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--ink);
  }

  .key.full { flex-basis: 100%; }
  .key.nav { color: var(--muted); }

  .caption {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
    margin: -8px 0 18px;
    max-width: 420px;
  }

  /* ---------- Лестница статусов ---------- */

  .ladder {
    display: grid;
    gap: 0;
    margin: 6px 0 0;
    border-top: 1px solid var(--rule-soft);
  }

  .rung {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 4px 14px;
    padding: 13px 0;
    border-bottom: 1px solid var(--rule-soft);
    align-items: start;
  }

  .rung .icon {
    font-size: 20px;
    line-height: 1.3;
  }

  .rung .name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.25;
  }

  .rung .who {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .rung .what {
    grid-column: 2;
    font-size: 16px;
    color: var(--ink);
  }

  .rung.rejected .name { color: var(--alert); }

  /* ---------- Врезки ---------- */

  .note {
    border-left: 3px solid var(--mark);
    background: var(--surface);
    padding: 13px 16px;
    margin: 18px 0;
    font-size: 16px;
    max-width: var(--col);
  }

  .note.warn { border-left-color: var(--alert); }

  .note p { margin-bottom: 8px; }
  .note p:last-child { margin-bottom: 0; }

  /* ---------- Список «что делать, если» ---------- */

  .faq { margin: 4px 0 0; }

  .faq div {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-soft);
  }

  .faq div:first-child { border-top: 1px solid var(--rule-soft); }

  .faq dt {
    font-family: var(--display);
    font-weight: 600;
    font-size: 19px;
    margin-bottom: 4px;
  }

  .faq dd { margin: 0; }

  /* ---------- Команды ---------- */

  .cmds {
    display: grid;
    gap: 10px;
    margin-top: 6px;
  }

  .cmd {
    display: grid;
    grid-template-columns: minmax(0, 148px) minmax(0, 1fr);
    gap: 4px 16px;
    align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .cmd code {
    background: none;
    border: none;
    padding: 0;
    font-size: 16px;
    font-weight: 500;
    white-space: nowrap;
  }

  footer {
    padding: 34px 0 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 13px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  a { color: inherit; text-underline-offset: 3px; }
  a:focus-visible, .key:focus-visible { outline: 2px solid var(--mark); outline-offset: 2px; }
</style>
