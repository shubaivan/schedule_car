{#
  whPicker(селектор, опції) — пошук у списку наявних і, якщо задано create,
  «➕ Додати …» для нового. Нове приходить на сервер як «new:Назва»
  (WarehouseDirectory::NEW), і вже там шукається дубль за назвою без регістру
  й розділових знаків — тож «фоп петренко» не стане другим «ФОП Петренко».

  raw — нове приходить як є, без префікса (для простих значень, як одиниця виміру).
  url — підвантажувати з сервера (довідник великий); без url — шукає серед
  <option>/<optgroup> самого select.
#}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
  const WH_NEW = {{ constant('App\\Warehouse\\Service\\WarehouseDirectory::NEW')|json_encode|raw }};
  const whNorm = s => (s || '').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '');

  function whPicker(selector, opts = {}) {
    const config = {
      placeholder: opts.placeholder || '— оберіть —',
      allowClear: !opts.required,
      language: {
        searching: () => 'Шукаю…',
        noResults: () => opts.create ? 'Нічого — допишіть назву повністю' : 'Нічого не знайдено',
      },
      templateResult: d => {
        if (d.loading) return d.text;
        if (d.isNew) return $('<span>').text('➕ Додати «' + d.text + '» ' + opts.create);
        return d.edrpou ? $('<span>').text(d.text).append($('<span class="muted small">').text(' · ' + d.edrpou)) : d.text;
      },
    };

    if (opts.hideDisabled) {
      // Вимкнені варіанти (скажімо, щит, якого немає в місці «звідки») — не показуємо зовсім.
      const base = $.fn.select2.defaults.defaults.matcher;
      config.matcher = (params, data) => (data.element && data.element.disabled ? null : base(params, data));
    }

    if (opts.url) {
      config.ajax = {
        url: opts.url,
        dataType: 'json',
        delay: 200,
        data: params => ({ q: params.term || '' }),
        processResults: data => ({ results: data.results }),
      };
    }

    if (opts.create) {
      config.tags = true;
      config.createTag = params => {
        const term = (params.term || '').trim();
        return term === '' ? null : { id: (opts.raw ? '' : WH_NEW) + term, text: term, isNew: true };
      };
      // Нового пропонуємо, лише коли такої назви у списку ще немає.
      config.insertTag = (data, tag) => {
        const flat = data.flatMap(d => d.children || [d]);
        if (!flat.some(d => whNorm(d.text) === whNorm(tag.text))) data.push(tag);
      };
    }

    const $el = $(selector).select2(config);
    if (opts.create) whAddButton($el, opts);
    return $el;
  }

  // «Допишіть назву» ніхто не вгадує: внизу відкритого списку — явна кнопка,
  // що відкриває віконце з назвою. Далі те саме, що й дописана назва: «new:Назва».
  function whAddButton($el, opts) {
    $el.on('select2:open', () => {
      const $results = $('.select2-container--open .select2-results');
      if ($results.find('.wh-add').length) return;
      $('<button type="button" class="wh-add">').text('➕ Додати ' + opts.create)
        .on('mousedown', e => e.preventDefault())
        .on('click', () => {
          const term = $('.select2-container--open .select2-search__field').val() || '';
          $el.select2('close');
          whAskName(opts.create, term.trim(), name => {
            const id = (opts.raw ? '' : WH_NEW) + name;
            const known = [...$el[0].options].find(o => whNorm(o.text) === whNorm(name));
            if (known) $el.val(known.value);
            else $el.append(new Option(name, id, true, true));
            $el.trigger('change');
          });
        })
        .appendTo($results);
    });
  }

  function whAskName(what, value, done) {
    let dialog = document.getElementById('whAddDialog');
    if (!dialog) {
      dialog = document.createElement('dialog');
      dialog.id = 'whAddDialog';
      dialog.innerHTML = '<form method="dialog"><h3></h3><input name="name" required autocomplete="off">'
        + '<div class="wh-add-actions"><button class="btn primary" value="ok">Додати</button>'
        + '<button class="btn" value="cancel" formnovalidate>Скасувати</button></div></form>';
      document.body.appendChild(dialog);
    }
    dialog.querySelector('h3').textContent = 'Додати ' + what;
    const input = dialog.querySelector('input');
    input.value = value;
    dialog.onclose = () => {
      const name = input.value.trim();
      if (dialog.returnValue === 'ok' && name !== '') done(name);
    };
    dialog.returnValue = '';
    dialog.showModal();
    input.focus();
  }
</script>
