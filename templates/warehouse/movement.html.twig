{% extends 'warehouse/layout.html.twig' %}
{% block title %}{{ movement.title }}{% endblock %}
{% block body %}
<h1>{{ movement.type.emoji }} {{ movement.title }}</h1>
{% include 'warehouse/_share.html.twig' %}
<div class="grid">
  <div class="card">
    <dl class="facts">
      <dt>Звідки</dt><dd>{% if movement.fromSite %}<a href="{{ path('wh_site', {id: movement.fromSite.id}) }}">{{ movement.fromSite.label }}</a>{% else %}{{ movement.supplier ? movement.supplier.name : 'ззовні' }}{% endif %}</dd>
      <dt>Куди</dt><dd>{% if movement.toSite %}<a href="{{ path('wh_site', {id: movement.toSite.id}) }}">{{ movement.toSite.label }}</a>{% else %}списано{% endif %}</dd>
      {% set fromClient = movement.fromSite ? movement.fromSite.client : null %}
      {% set toClient = movement.toSite ? movement.toSite.client : null %}
      {% if fromClient and toClient and fromClient.id != toClient.id %}
        {# Об'єкт одного клієнта → об'єкт іншого, повз склад: обидва мають бачити цей рух. #}
        <dt>Від клієнта</dt><dd><a href="{{ path('wh_client', {id: fromClient.id}) }}">{{ fromClient.name }}</a></dd>
        <dt>Клієнту</dt><dd><a href="{{ path('wh_client', {id: toClient.id}) }}">{{ toClient.name }}</a></dd>
      {% elseif movement.client %}<dt>Клієнт</dt><dd><a href="{{ path('wh_client', {id: movement.client.id}) }}">{{ movement.client.name }}</a></dd>{% endif %}
      <dt>Записав</dt><dd>{{ movement.createdBy ? movement.createdBy.displayName : '—' }} · {{ movement.createdAt|date('d.m.Y H:i') }}</dd>
    </dl>
    {% if movement.note %}<p style="white-space:pre-line">{{ movement.note }}</p>{% endif %}
  </div>
  <div class="card">
    <h2>Позиції</h2>
    <table class="stack">
      <tr class="th"><th>Позиція</th><th class="num">К-сть</th><th class="num">Оренда/доба</th></tr>
      {% for l in movement.lines %}
        <tr>
          <td data-label="Позиція"><a href="{{ path('wh_item', {id: l.item.id}) }}">{{ l.item.label }}</a></td>
          <td data-label="К-сть" class="num">{{ l.quantity }} {{ l.item.unit }}</td>
          <td data-label="Оренда/доба" class="num">{{ l.rentalRate is not null ? l.rentalRate|number_format(2, ',', ' ') : '—' }}</td>
        </tr>
      {% endfor %}
    </table>
  </div>
</div>
{% include 'warehouse/_documents.html.twig' with {owner: 'movement', ownerId: movement.id, defaultType: 'waybill'} %}
{% include 'warehouse/_journal.html.twig' with {journalLink: path('wh_journal', {type: 'movement'})} %}
{% endblock %}
