{% extends 'warehouse/layout.html.twig' %}
{% set v = values ?? {} %}
{% block title %}{{ type.label }}{% endblock %}
{% macro siteOptions(sites, kind, selected) %}
  {# Склади — окремо, об'єкти — під своїм клієнтом: так видно, чий об'єкт, і рух від клієнта до клієнта не плутається. #}
  {% set groups = {} %}
  {% for s in sites %}
    {% if kind is null or s.kind == kind %}
      {% set g = s.warehouse ? '🏠 Склади' : (s.client ? s.client.name : "Власні об'єкти") %}
      {% set groups = groups|merge({(g): (groups[g] ?? [])|merge([s])}) %}
    {% endif %}
  {% endfor %}
  {% for g, list in groups %}
    <optgroup label="{{ g }}">
      {% for s in list %}<option value="{{ s.id }}" {{ selected == s.id or selected == s.id ~ '' ? 'selected' }}>{{ s.name }}</option>{% endfor %}
    </optgroup>
  {% endfor %}
{% endmacro %}
{% block body %}
<h1>{{ type.emoji }} {{ type.label }}</h1>
<div class="row" style="margin-bottom:12px">
  {% for t in types %}
    <a class="btn {{ t == type ? 'primary' }}" href="{{ path('wh_movement_new', {type: t.value}) }}">{{ t.emoji }} {{ t.label }}</a>
  {% endfor %}
</div>
{% if type.value == 'transfer' %}
  <p class="muted small">Переміщення — з місця на місце напряму, без заїзду на склад: з об'єкта на об'єкт, зокрема від одного клієнта до іншого, або між складами. Ставка оренди — вже для нового місця.</p>
{% endif %}

<form class="card" method="post" enctype="multipart/form-data">
  <input type="hidden" name="_token" value="{{ csrf_token('warehouse') }}">
  <input type="hidden" name="type" value="{{ type.value }}">
  <div class="fields">
    <div class="field"><label>Дата за документом *</label>
      <input type="date" name="occurredAt" required value="{{ v.occurredAt ?? today }}"></div>
    <div class="field"><label>№ накладної / акта</label>
      <input type="text" name="documentNumber" value="{{ v.documentNumber ?? '' }}"></div>

    {% if type.needsFrom %}
    <div class="field"><label>Звідки *</label>
      <select name="fromId" id="fromId" required>
        <option value=""></option>
        {{ _self.siteOptions(sites, type.fromKind, v.fromId ?? presetFrom) }}
      </select></div>
    {% else %}
    <div class="field"><label>Від кого (постачальник)</label>
      <select name="supplierId" id="supplier">
        <option value=""></option>
        {% if supplierChoice %}<option value="{{ supplierChoice.id }}" selected>{{ supplierChoice.text }}</option>{% endif %}
      </select>
      <span class="muted small">Спільний довідник із заявками. Немає — допишіть назву.</span></div>
    {% endif %}

    {% if type.needsTo %}
    <div class="field"><label>Куди *</label>
      {% set toSel = v.toId ?? presetTo %}
      <select name="toId" id="toId" required>
        <option value=""></option>
        {% if toSel starts with constant('App\\Warehouse\\Service\\WarehouseDirectory::NEW') %}<option value="{{ toSel }}" selected>{{ toSel|slice(4) }}</option>{% endif %}
        {{ _self.siteOptions(sites, type.toKind, toSel) }}
      </select>
      <span class="muted small">Немає в списку — допишіть назву, {{ type.toKind and type.toKind.value == 'warehouse' ? 'склад' : "об'єкт" }} заведеться сам.</span>
    </div>
    {% if type.toKind is null or type.toKind.value == 'site' %}
    <div class="field" id="toClientField" hidden><label>Чий новий об'єкт (клієнт) *</label>
      <select name="toClientId" id="toClient">
        <option value=""></option>
        {% if toClientChoice and toClientChoice.id starts with 'new:' %}<option value="{{ toClientChoice.id }}" selected>{{ toClientChoice.text }}</option>{% endif %}
        {% for c in clients %}<option value="{{ c.id }}" {{ toClientChoice and toClientChoice.id == c.id ~ '' ? 'selected' }}>{{ c.name }}</option>{% endfor %}
      </select>
      <span class="muted small">Без клієнта оренда на об'єкті не рахується.</span>
    </div>
    {% endif %}
    {% endif %}
  </div>

  <h2 style="margin-top:16px">Позиції</h2>
  <div class="table-wrap"><table id="lines" class="stack">
    <tr class="th"><th>Позиція</th><th style="width:110px">Кількість</th>{% if type.value in ['shipment', 'transfer'] %}<th style="width:150px">Оренда, грн/доба</th>{% endif %}<th></th></tr>
  </table></div>
  <button type="button" id="addLine" style="margin-top:8px">+ позиція</button>
  <p class="muted small">Поштучна річ — завжди 1. Ставку оренди не вказали — візьметься з картки позиції (лише коли везуть клієнту).</p>

  <div class="fields" style="margin-top:12px">
    <div class="field wide"><label>Примітка</label><textarea name="note">{{ v.note ?? '' }}</textarea></div>
    <div class="field"><label>Документ до руху</label>
      <select name="documentType">
        {% for t in documentTypes %}<option value="{{ t.value }}" {{ t.value == (type.value == 'receipt' ? 'waybill' : (type.value == 'shipment' ? 'expense' : 'waybill')) ? 'selected' }}>{{ t.label }}</option>{% endfor %}
      </select></div>
    <div class="field"><label>Файли (накладна, акт, фото)</label>
      <input type="file" name="files[]" multiple accept=".pdf,.jpg,.jpeg,.png,.heic,.webp,.doc,.docx,.xls,.xlsx"></div>
  </div>

  <div class="row" style="margin-top:16px">
    <button class="primary" type="submit">Записати {{ type.label|lower }}</button>
    <a class="btn" href="{{ path('wh_movements') }}">Скасувати</a>
  </div>
</form>

<template id="lineTpl">
  <tr>
    <td data-label="Позиція"><select name="item[]" class="item" required style="width:100%"><option value="">— оберіть —</option>
      {% for i in items %}<option value="{{ i.id }}" data-unit="{{ i.tracking.value == 'unit' ? 1 : 0 }}" data-u="{{ i.unit }}" data-site="{{ i.currentSite ? i.currentSite.id : '' }}" data-rate="{{ i.rentalRate }}">{{ i.inventoryNumber }} · {{ i.name }}{% if i.tracking.value == 'unit' %} — {{ i.currentSite ? i.currentSite.name : 'не надійшло' }}{% endif %}</option>{% endfor %}
    </select></td>
    <td data-label="Кількість"><input type="number" name="quantity[]" class="qty" min="1" value="1" required style="width:100px"></td>
    {% if type.value in ['shipment', 'transfer'] %}<td data-label="Оренда/доба"><input type="text" inputmode="decimal" name="rate[]" class="rate" style="width:140px"></td>{% endif %}
    <td data-label=""><button type="button" class="danger del" title="Прибрати рядок">✕</button></td>
  </tr>
</template>
{% endblock %}
{% block head %}{% include 'warehouse/_select2_head.html.twig' %}{% endblock %}
{% block scripts %}
{% include 'warehouse/_select2_js.html.twig' %}
<script>
  const table = document.getElementById('lines');
  const tpl = document.getElementById('lineTpl');
  const from = document.getElementById('fromId');

  function sync(row) {
    const option = row.querySelector('.item').selectedOptions[0];
    const qty = row.querySelector('.qty');
    const unit = option && option.dataset.unit === '1';
    qty.readOnly = unit;
    if (unit) qty.value = 1;
    const rate = row.querySelector('.rate');
    if (rate && option && !rate.value) rate.placeholder = option.dataset.rate || '';
  }

  // Поштучні речі, яких немає в місці «звідки», ховаємо зі списку — їх туди й не записати.
  function filterByFrom(row) {
    if (!from) return;
    row.querySelectorAll('.item option[value]').forEach(o => {
      if (!o.value) return;
      // disabled, а не hidden: select2 не зважає на hidden, а вимкнені whPicker ховає з пошуку.
      o.disabled = o.dataset.unit === '1' && from.value !== '' && o.dataset.site !== from.value;
    });
  }

  function addLine(itemId = '', qty = '', rate = '') {
    const row = tpl.content.firstElementChild.cloneNode(true);
    table.appendChild(row);
    const select = row.querySelector('.item');
    select.value = itemId;
    if (qty) row.querySelector('.qty').value = qty;
    if (rate && row.querySelector('.rate')) row.querySelector('.rate').value = rate;
    whPicker(select, { required: true, hideDisabled: true, placeholder: 'почніть вводити назву або інв. номер' })
      .on('change', () => sync(row));
    row.querySelector('.del').addEventListener('click', () => row.remove());
    filterByFrom(row);
    sync(row);
  }

  // Єдиний можливий варіант (скажімо, один склад) обираємо одразу — менше кліків.
  document.querySelectorAll('select[name="fromId"], select[name="toId"]').forEach(select => {
    const options = [...select.options].filter(o => o.value);
    if (!select.value && options.length === 1) select.value = options[0].value;
  });

  document.getElementById('addLine').addEventListener('click', () => addLine());

  // Списки місць і постачальників — з пошуком; «куди» й постачальника можна дописати новими.
  if (from) whPicker(from, { required: true }).on('change', () => table.querySelectorAll('tr').forEach(filterByFrom));
  if (document.getElementById('supplier')) {
    whPicker('#supplier', { url: {{ path('wh_suppliers')|json_encode|raw }}, placeholder: 'почніть вводити назву', create: 'у довідник постачальників' });
  }
  const to = document.getElementById('toId');
  const toClientField = document.getElementById('toClientField');
  if (to) {
    whPicker(to, { required: true, create: {{ (type.toKind and type.toKind.value == 'warehouse' ? 'як новий склад' : "як новий об'єкт")|json_encode|raw }} })
      .on('change', () => { if (toClientField) toClientField.hidden = !to.value.startsWith(WH_NEW); });
    if (toClientField) {
      toClientField.hidden = !to.value.startsWith(WH_NEW);
      whPicker('#toClient', { placeholder: 'клієнт', create: 'як нового клієнта' });
    }
  }

  const posted = {{ {items: v.item ?? [], qty: v.quantity ?? [], rate: v.rate ?? []}|json_encode|raw }};
  if (posted.items.length) {
    posted.items.forEach((id, i) => addLine(id, posted.qty[i] || '', posted.rate[i] || ''));
  } else {
    addLine('{{ preset }}');
  }
</script>
{% endblock %}
