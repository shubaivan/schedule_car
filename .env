# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=74f695912da245147027c6b64f5ae9b8
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

TELEGRAM_TOKEN=!ChangeMe!

# Публічна адреса застосунку: з неї збираються посилання на CRM у повідомленнях бота.
APP_BASE_URL=http://localhost
# Телефони менеджерів постачання через кому — вони отримують роль одразу при реєстрації в боті.
SUPPLY_MANAGER_PHONES=
# Телефони тих, хто погоджує оплату (директор) — так само отримують роль одразу.
SUPPLY_DIRECTOR_PHONES=
# Секрет вебхука Telegram. Порожній — перевірка вимкнена (локальна розробка).
TELEGRAM_WEBHOOK_SECRET=
# Ім'я бота для посилання на титульній сторінці.
TELEGRAM_BOT_USERNAME=tbuddet_schedule_car_bot

###> Google Drive: упорядкований архів документів заявок ###
# Ключі OAuth від акаунта «Буддеталі» — реальні значення лише в .env.local на сервері.
# Порожні = копіювання вимкнено, файли живуть тільки в нашому сховищі.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Тека, всередині якої створювати дерево. Порожньо = корінь диску.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Як назвати теку заявок на Диску. Якщо в клієнта вже є своя «Постачання» —
# дайте іншу назву, інакше буде дві однакові теки. На стенді з наповненим Диском не міняти.
GOOGLE_DRIVE_SUPPLY_FOLDER=Постачання
###< Google Drive ###
APP_COMPANY_NAME="Завод Буддеталь"

###> автопарк ###
# 0 — розділ «Автопарк» зникає з меню бота, дані лишаються
FLEET_ENABLED=1
###< автопарк ###

###> доступ ###
# 1 — пускати лише тих, чий номер внесено в «Люди» (чи в довідник водіїв):
# незнайомий номер одразу отримує відмову, запиту на підтвердження немає.
ACCESS_ONLY_LISTED=0
###< доступ ###

###> магазин ###
# Адмінка сайту-магазину, в яку веде пункт «🛒 Магазин» (без другого логіна).
# Порожньо — магазину в цього клієнта немає. Секрет — той самий, що CRM_SSO_SECRET на сайті.
SHOP_ADMIN_URL=
SHOP_SSO_SECRET=
###< магазин ###

###> склад ###
# 1 — розділ «Склад»: облік опалубки й техніки, оренда, QR-наклейки.
# Вмикається на стенді того клієнта, якому він потрібен.
WAREHOUSE_ENABLED=0
###< склад ###

###> робоча група ###
# Telegram-група клієнта з темами: бот публікує туди події розділів.
# Порожній TEAM_CHAT_ID — групи немає, нічого не пишемо. Порожня тема — General.
# id тем повертає createForumTopic (Telegram не вміє їх перелічити).
TEAM_CHAT_ID=
TEAM_CHAT_TOPIC_SUPPLY=
TEAM_CHAT_TOPIC_WAREHOUSE=
TEAM_CHAT_TOPIC_FLEET=
###< робоча група ###

# Розділ «Задачі» (угоди, чат по задачі, файли з превʼю) і вхід за паролем.
TASKS_ENABLED=0
PASSWORD_LOGIN_ENABLED=0
# З якого розділу відкривається CRM: requests | tasks
CRM_HOME=requests

###> plan events ###
# Транспорт розсилки подій «Плану». sync:// — усе в запиті (стенди заявок);
# doctrine://default?queue_name=plan — через воркер messenger:consume plan.
PLAN_EVENTS_TRANSPORT=sync://
###< plan events ###

###> symfony/mercure-bundle ###
# Живі події «Плану» (S1). MERCURE_URL порожній — хаба немає: нічого не
# публікуємо, фронт опитує сервер (стенди заявок, тести, локально без хаба).
# На Плані: MERCURE_URL=http://127.0.0.1:3100/.well-known/mercure (публікація з воркера),
# MERCURE_PUBLIC_URL=https://plan.zavodbuddetal.com.ua/.well-known/mercure,
# MERCURE_JWT_SECRET — той самий ключ, що MERCURE_PUBLISHER/SUBSCRIBER_JWT_KEY хаба.
MERCURE_URL=
MERCURE_PUBLIC_URL=/.well-known/mercure
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
MERCURE_JWT_ISSUER=plan
###< symfony/mercure-bundle ###

###> plan notifications (S1) ###
# Web Push (VAPID): `php bin/console plan:push:vapid-keys` → .env.local. Порожні — push вимкнено.
PLAN_VAPID_PUBLIC_KEY=
PLAN_VAPID_PRIVATE_KEY=
# 1 — бот цього розгортання є ботом «Плану» (@zavod_buddetal_plan_bot): лише
# сповіщення, /start /mute /help, кнопка «Відкрити». Токен і ім'я бота — звичні
# TELEGRAM_TOKEN / TELEGRAM_BOT_USERNAME / TELEGRAM_WEBHOOK_SECRET у .env.local.
PLAN_TELEGRAM_BOT=0
###< plan notifications (S1) ###
