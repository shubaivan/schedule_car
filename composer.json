{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7.5",
        "endroid/qr-code": "^6.2",
        "friendsofsymfony/jsrouting-bundle": "^3.6",
        "google/apiclient": "^2.20",
        "lcobucci/jwt": "^5.6",
        "league/flysystem-bundle": "^3.7",
        "martin-georgiev/postgresql-for-doctrine": "^4.10",
        "minishlink/web-push": "^11.0",
        "nutgram/symfony-bundle": "^1.2",
        "oro/doctrine-extensions": "^3.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.4",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mercure-bundle": "^0.7.0",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/notifier": "8.1.*",
        "symfony/polyfill-php86": "^1.37",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-turbo": "^3.7",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.29",
        "twig/twig": "^3.30"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs-fixer": [
            "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php"
        ],
        "cs-check": [
            "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff"
        ],
        "analyze": [
            "php bin/console cache:warmup --env=dev -q",
            "php vendor/bin/phpstan analyse -c phpstan.dist.neon --memory-limit=1G"
        ],
        "migrate-test": [
            "php bin/console doctrine:migrations:migrate --env=test --no-interaction"
        ],
        "test": [
            "@migrate-test",
            "php vendor/bin/phpunit"
        ],
        "quality": [
            "@cs-check",
            "@analyze",
            "@test"
        ],
        "install-git-hooks": [
            "hooks=$(git rev-parse --git-path hooks) && mkdir -p \"$hooks\" && ln -sf \"$(pwd)/.git-tools/hooks/pre-commit\" \"$hooks/pre-commit\" && echo \"pre-commit hook -> $hooks\""
        ],
        "analyze-changed": [
            "files=$(git diff --name-only --diff-filter=d \"${BASE:-origin/master}\"...HEAD -- src tests | grep \"\\.php$\"); if [ -n \"$files\" ]; then php bin/console cache:warmup --env=dev -q && php vendor/bin/phpstan analyse -c phpstan.dist.neon --memory-limit=1G $files; else echo \"No changed PHP files vs ${BASE:-origin/master}\"; fi"
        ],
        "fix-changed": [
            "files=$(git diff --name-only --diff-filter=d \"${BASE:-origin/master}\"...HEAD | grep \"\\.php$\"); if [ -n \"$files\" ]; then php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --path-mode=intersection $files; else echo \"No changed PHP files vs ${BASE:-origin/master}\"; fi"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/phpunit-bridge": "8.1.*",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "scripts-descriptions": {
        "install-git-hooks": "Link .git-tools/hooks/pre-commit (cs-fixer + PHPStan on staged files)",
        "analyze-changed": "PHPStan on PHP files changed vs $BASE (default origin/master)",
        "fix-changed": "PHP-CS-Fixer on PHP files changed vs $BASE (default origin/master)"
    }
}
